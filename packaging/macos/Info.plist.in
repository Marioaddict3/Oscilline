<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Configured by CMake for the Oscilline app bundle. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Oscilline</string>
    <key>CFBundleExecutable</key>
    <string>oscilline</string>
    <key>CFBundleIconFile</key>
    <string>oscilline.icns</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.marioaddict3.Oscilline</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Oscilline</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music-games</string>
    <key>LSMinimumSystemVersion</key>
    <string>${OSCILLINE_MACOS_MINIMUM}</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
